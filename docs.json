{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Project Territory",
  "description": "Player guide, API reference, and development guides for the Project Territory framework.",
  "colors": {
    "primary": "#d1b287",
    "light": "#e5cda0",
    "dark": "#d1b287"
  },
  "logo": {
    "light": "/images/territory-crest.webp",
    "dark": "/images/territory-crest.webp"
  },
  "favicon": "/images/territory-crest.webp",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Rye"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Welcome",
            "pages": [
              "introduction"
            ]
          }
        ]
      },
      {
        "tab": "Player Guide",
        "groups": [
          {
            "group": "Playing",
            "pages": [
              "player/index",
              "player/satchel",
              "player/trade",
              "player/money",
              "player/shops",
              "player/weapons",
              "player/characters"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "api/index"
            ]
          },
          {
            "group": "Core",
            "pages": [
              "api/fw-core",
              "api/fw-characters",
              "api/database"
            ]
          },
          {
            "group": "Inventory",
            "pages": [
              "api/fw-inventory",
              "api/fw-money",
              "api/fw-weapons",
              "api/fw-satchel"
            ]
