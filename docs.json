    "global": {
      "anchors": [
        {
          "anchor": "RDR3 Natives",
          "href": "https://rdr3natives.com",
          "icon": "book-open"
        },
        {
          "anchor": "RDR3 Discoveries",
          "href": "https://github.com/femga/rdr3_discoveries",
          "icon": "github"
        },
        {
          "anchor": "RDR3 Decompiled Scripts",
          "href": "https://github.com/outsider31000/rdr2-scripts-decompiled",
          "icon": "github"
        },
        {
          "anchor": "RDR3 Native Flags and Enums",
