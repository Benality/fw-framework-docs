            "pages": [
              "api/fw-menu",
              "api/fw-guide",
              "api/fw-loading",
              "api/fw-creator",
              "api/fw-clothing",
              "api/fw-admin"
            ]
          },
          {
            "group": "Library",
            "pages": [
              "api/vorp-lib"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "guides/first-resource",
              "guides/crafting",
              "guides/faq"
            ]
          },
          {
            "group": "Lua and RedM",
            "pages": [
              "guides/lua",
              "guides/events",
              "guides/threads",
              "guides/best-practices",
              "guides/resources"
            ]
          }
        ]
